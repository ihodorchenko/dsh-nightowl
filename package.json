{
  "name": "dsh-nightowl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeps your Mac awake while DeepSeek Harness works; the display may still turn off and closing the lid sleeps normally.",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"tests/**/*.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihodorchenko/dsh-nightowl.git"
  },
  "homepage": "https://github.com/ihodorchenko/dsh-nightowl#readme",
  "bugs": {
    "url": "https://github.com/ihodorchenko/dsh-nightowl/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "macos",
    "caffeinate",
    "sleep"
  ],
  "license": "MIT"
}
